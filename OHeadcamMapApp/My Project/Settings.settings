  <Settings>
    <Setting Name="ffmpegVidstabDetect" Type="System.String" Scope="User">
      <Value Profile="(Default)">vidstabdetect=shakiness=10:accuracy=15:mincontrast=0.200:stepsize=6:show=0:result=data.trf:tripod=0:result=data.trf</Value>
    </Setting>
    <Setting Name="ffmpegVidstabTransform" Type="System.String" Scope="User">
      <Value Profile="(Default)">vidstabtransform=smoothing=25:crop=black:zoom=0:optzoom=0:interpol='bicubic':input=data.trf:tripod=0,unsharp=7:7:3:7:7:3</Value>
    </Setting>
    <Setting Name="ffmpegVidstabDetectOut" Type="System.String" Scope="User">
      <Value Profile="(Default)"> -f null -</Value>
    </Setting>
